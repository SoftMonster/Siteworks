{
  "manifest_version": 3,
  "name": "Site Works",
  "version": "1.3.0",
  "description": "Runs your own scripts on websites, picked by folder, only after you allow each one. Includes a script editor, file helper, clipboard tool and cross-site toolbox.",
  "key": "",
  "minimum_chrome_version": "106",
  "permissions": [
    "scripting",
    "webNavigation",
    "storage",
    "contextMenus",
    "nativeMessaging",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "manage.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Site Works",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Open the Site Works menu"
    },
    "open-toolbox": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Open the toolbox on this page"
    },
    "toggle-pause": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pause or resume Site Works on this website"
    },
    "toggle-enabled": {
      "description": "Turn Site Works on or off everywhere"
    },
    "new-script": {
      "description": "New script for this page"
    }
  }
}
